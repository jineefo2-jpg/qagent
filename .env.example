# ─── DeepSeek（主 LLM）───
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# ─── 可选：Redis（缓存 + 会话）───
# REDIS_URL=redis://localhost:6379/0

# ─── 可选：LangGraph 主循环 ───
# USE_LANGGRAPH=1

# ─── 可选：Token 批处理参数（LangGraph 模式下）───
# LG_TOKEN_FLUSH_MS=30
# LG_TOKEN_FLUSH_CHARS=40

# ─── 可选：入口结果缓存 ───
# ANSWER_CACHE_ENABLE=1
# ANSWER_CACHE_TTL=300

# ─── 可选：启动预热 ───
# WARMUP=1

# ─── Alpaca Paper Trading（半自动下单）───
# 1. 注册：https://app.alpaca.markets/signup（不要走 broker-app）
# 2. 切到 Paper Trading 模式 → API Keys → Generate New Key
# 3. 把 Key ID（PK 开头）和 Secret Key 填到下面
ALPACA_API_KEY=PK_xxxxxxxxxxxxxxxxxx
ALPACA_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# ─── OAuth 账户登录（Google / GitHub）───
# 1. Google: https://console.cloud.google.com/apis/credentials
#    创建 OAuth Client (Web) → 回调填: http://localhost:8001/auth/google/callback
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
# 2. GitHub: https://github.com/settings/developers
#    New OAuth App → 回调填: http://localhost:8001/auth/github/callback
GITHUB_CLIENT_ID=Iv1.xxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxx

# Cookie 签名密钥（建议 openssl rand -hex 32 生成；不设会用临时密钥，重启失效）
APP_SECRET_KEY=

# 部署到非 localhost 时改这个（含 schema 和端口，不含末尾斜杠）
OAUTH_REDIRECT_BASE=http://localhost:8001

# HTTPS 部署时设为 1（cookie 仅 HTTPS 下发送）
# OAUTH_COOKIE_SECURE=1

# 可选：邮箱白名单（逗号分隔；不设 = 开放注册）
# AUTH_EMAIL_WHITELIST=you@gmail.com,friend@gmail.com

# ─── 风控阈值（可选；不设走代码默认）───
# RISK_MAX_SINGLE_PCT=0.20           # 单笔上限（占净值）
# RISK_MAX_SINGLE_PCT_ETF=0.50       # ETF 标的上限
# RISK_DOUBLE_CONFIRM_PCT=0.50       # 超过此比例需前端二次确认
# RISK_MAX_DAILY_ORDERS=20
# RISK_MAX_DAILY_CANCEL_RATE=0.40
# RISK_BLOCK_MARKET_ORDER=1          # 1 = 禁市价单（防滑点）
# RISK_WHITELIST=SPY,QQQ,AAPL,MSFT,NVDA   # 逗号分隔；不设走默认白名单
